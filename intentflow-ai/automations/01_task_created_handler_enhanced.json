{
  "name": "01 - Task Created Handler (Enhanced)",
  "nodes": [
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "task-created",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000002",
      "name": "Validate Webhook Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000002b",
      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "req1",
              "leftValue": "={{ $json.body.data.task_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            },
            {
              "id": "req2",
              "leftValue": "={{ $json.body.data.title }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            },
            {
              "id": "req3",
              "leftValue": "={{ $json.body.data.user_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "Has Due Date?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 220],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "cond2",
              "leftValue": "={{ $json.body.data.due_date }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000003b",
      "name": "Validate Due Date Format",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 160],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "dateValid",
              "leftValue": "={{ /^\\d{4}-\\d{2}-\\d{2}$/.test($json.body.data.due_date) }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "Create Google Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [1340, 120],
      "parameters": {
        "operation": "create",
        "calendar": { "__rl": true, "value": "primary", "mode": "id" },
        "start": "={{ $json.body.data.due_date }}T{{ $json.body.data.due_time || '09:00' }}:00",
        "end": "={{ $json.body.data.due_date }}T{{ ($json.body.data.due_time || '09:00').split(':').map((v, i) => i === 0 ? String(parseInt(v) + 1).padStart(2,'0') : v).join(':') }}:00",
        "additionalFields": {
          "summary": "={{ $json.body.data.title }}",
          "description": "Created by IntentFlow AI\nTask ID: {{ $json.body.data.task_id }}"
        }
      },
      "credentials": { "googleCalendarOAuth2Api": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Google Calendar" } }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000005",
      "name": "Update Task with Calendar ID",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1560, 120],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tasks SET calendar_event_id = '{{ $json.id }}' WHERE id = '{{ $('Validate Required Fields').item.json.body.data.task_id }}';"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } },
      "onError": "continue"
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000006",
      "name": "Generate Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.OPENAI_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"model\": \"text-embedding-3-small\",\n  \"input\": \"{{ $('Validate Required Fields').item.json.body.data.title + ' ' + ($('Validate Required Fields').item.json.body.data.description || '') }}\"\n}"
      },
      "onError": "continue"
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000007",
      "name": "Store Embedding",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1560, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO task_embeddings (task_id, embedding, created_at)\nVALUES (\n  '{{ $('Validate Required Fields').item.json.body.data.task_id }}',\n  '{{ JSON.stringify($json.data[0].embedding) }}'::vector,\n  NOW()\n)\nON CONFLICT (task_id) DO UPDATE SET embedding = EXCLUDED.embedding, created_at = NOW();"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } },
      "onError": "continue"
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000008",
      "name": "Reject Invalid Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 500],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\": \"Unauthorized\", \"code\": \"AUTH_FAILED\"}",
        "options": { "responseCode": 401 }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000009",
      "name": "Reject Missing Fields",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 600],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\": \"Missing required fields: task_id, title, user_id\", \"code\": \"VALIDATION_ERROR\"}",
        "options": { "responseCode": 400 }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000010",
      "name": "Invalid Date Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 220],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\": \"Invalid date format. Expected YYYY-MM-DD\", \"code\": \"DATE_FORMAT_ERROR\"}",
        "options": { "responseCode": 400 }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000011",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1780, 220],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"task_id\": \"{{ $('Validate Required Fields').item.json.body.data.task_id }}\", \"processed\": true}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000012",
      "name": "Log Error",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1780, 420],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_errors (workflow_id, node_name, error_message, error_data, created_at) VALUES ('intentflow-automation-01', '{{ $json.errorNode }}', '{{ $json.errorMessage }}', '{{ JSON.stringify($json) }}', NOW());"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000013",
      "name": "Catch All Errors",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [1560, 420],
      "parameters": {}
    }
  ],
  "connections": {
