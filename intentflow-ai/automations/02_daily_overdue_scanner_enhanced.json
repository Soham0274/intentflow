{
  "name": "02 - Daily Overdue Task Scanner (Enhanced)",
  "nodes": [
    {
      "id": "a2000000-0002-0002-0002-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 6 * * *" }]
        }
      }
    },
    {
      "id": "a2000000-0002-0002-0002-000000000002",
      "name": "Query Overdue Tasks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  t.id,\n  t.user_id,\n  t.title,\n  t.due_date,\n  t.priority,\n  t.description,\n  t.category,\n  CURRENT_DATE - t.due_date AS days_overdue,\n  u.email AS user_email,\n  u.name AS user_name,\n  u.notification_settings\nFROM tasks t\nJOIN users u ON t.user_id = u.id\nWHERE t.due_date < CURRENT_DATE\n  AND t.status = 'active'\n  AND (\n    t.last_notified_at IS NULL\n    OR t.last_notified_at::date < CURRENT_DATE\n  )\nORDER BY t.priority DESC, t.due_date ASC;"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } }
    },
    {
      "id": "a2000000-0002-0002-0002-000000000003",
      "name": "Has Overdue Tasks?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a2000000-0002-0002-0002-000000000004",
      "name": "Filter By User Notification Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 220],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst filtered = items.filter(item => {\n  let settings;\n  try {\n    settings = typeof item.json.notification_settings === 'string'\n      ? JSON.parse(item.json.notification_settings)\n      : item.json.notification_settings || {};\n  } catch (e) {\n    return true; // Default to allowing if settings unreadable\n  }\n  \n  // Check if overdue notifications are enabled\n  return settings.overdue_notifications !== false;\n});\n\nif (filtered.length === 0) return [];\nreturn filtered;"
      }
    },
    {
      "id": "a2000000-0002-0002-0002-000000000004b",
      "name": "Has Tasks After Filter?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 220],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "condFilter",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a2000000-0002-0002-0002-000000000005",
      "name": "Loop Over Overdue Tasks",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1340, 160],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "a2000000-0002-0002-0002-000000000006",
      "name": "Check Escalation Level",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 160],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "escalate1",
              "leftValue": "={{ $json.days_overdue }}",
              "rightValue": 7,
              "operator": { "type": "number", "operation": "gte" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a2000000-0002-0002-0002-000000000007",
      "name": "Send Overdue Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 120],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/notifications/send",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "user_id": "={{ $json.user_id }}",
          "task_id": "={{ $json.id }}",
          "message": "=⚠️ Task overdue ({{ $json.days_overdue }} day{{ $json.days_overdue > 1 ? 's' : '' }}): {{ $json.title }}",
          "type": "overdue",
          "urgency": "={{ $json.days_overdue >= 7 ? 'critical' : 'normal' }}",
          "data": "={{ JSON.stringify({ task_id: $json.id, days_overdue: $json.days_overdue, priority: $json.priority }) }}"
        },
        "options": { "timeout": 10000 }
      },
      "onError": "continue"
    },
    {
      "id": "a2000000-0002-0002-0002-000000000008",
      "name": "Send Critical Escalation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 240],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/notifications/send",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "user_id": "={{ $json.user_id }}",
          "task_id": "={{ $json.id }}",
          "message": "=🚨 CRITICAL: Task '{{ $json.title }}' is {{ $json.days_overdue }} days overdue! Immediate attention required.",
          "type": "overdue_critical",
          "urgency": "critical",
          "channels": ["push", "email"],
          "data": "={{ JSON.stringify({ task_id: $json.id, days_overdue: $json.days_overdue, priority: $json.priority }) }}"
        },
        "options": { "timeout": 10000 }
      },
      "onError": "continue"
    },
    {
      "id": "a2000000-0002-0002-0002-000000000009",
      "name": "Escalate Priority",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2000, 160],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tasks\nSET\n  priority = CASE\n    WHEN priority = 'low'    THEN 'medium'\n    WHEN priority = 'medium' THEN 'high'\n    ELSE 'high'\n  END,\n  last_notified_at = NOW(),\n  notification_count = COALESCE(notification_count, 0) + 1\nWHERE id = '{{ $('Loop Over Overdue Tasks').item.json.id }}';"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } },
      "onError": "continue"
    },
    {
      "id": "a2000000-0002-0002-0002-000000000010",
      "name": "Log Scan Results",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2220, 160],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_logs (workflow_id, run_date, tasks_processed, execution_status, created_at) VALUES ('intentflow-automation-02', CURRENT_DATE, {{ $('Filter By User Notification Settings').all().length || 0 }}, 'success', NOW());"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } },
      "onError": "continue"
    },
    {
      "id": "a2000000-0002-0002-0002-000000000011",
      "name": "No Overdue Tasks — Stop",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 380],
      "parameters": {}
    },
    {
      "id": "a2000000-0002-0002-0002-000000000012",
      "name": "All Notifications Disabled — Stop",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1340, 380],
      "parameters": {}
    },
    {
      "id": "a2000000-0002-0002-0002-000000000013",
      "name": "Catch Errors",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [1120, 500],
      "parameters": {}
    },
    {
      "id": "a2000000-0002-0002-0002-000000000014",
      "name": "Log Error",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1340, 500],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_errors (workflow_id, node_name, error_message, error_data, created_at) VALUES ('intentflow-automation-02', '{{ $json.errorNode }}', '{{ $json.errorMessage }}', '{{ JSON.stringify($json) }}', NOW());"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Query Overdue Tasks", "type": "main", "index": 0 }]]
    },
    "Query Overdue Tasks": {
      "main": [[{ "node": "Has Overdue Tasks?", "type": "main", "index": 0 }]]
    },
    "Has Overdue Tasks?": {
      "main": [
        [{ "node": "Filter By User Notification Settings", "type": "main", "index": 0 }],
        [{ "node": "No Overdue Tasks — Stop", "type": "main", "index": 0 }]
      ]
    },
    "Filter By User Notification Settings": {
      "main": [[{ "node": "Has Tasks After Filter?", "type": "main", "index": 0 }]]
    },
    "Has Tasks After Filter?": {
      "main": [
        [{ "node": "Loop Over Overdue Tasks", "type": "main", "index": 0 }],
        [{ "node": "All Notifications Disabled — Stop", "type": "main", "index": 0 }]
      ]
    },
    "Loop Over Overdue Tasks": {
      "main": [[{ "node": "Check Escalation Level", "type": "main", "index": 0 }]]
    },
    "Check Escalation Level": {
      "main": [
        [{ "node": "Send Critical Escalation", "type": "main", "index": 0 }],
        [{ "node": "Send Overdue Notification", "type": "main", "index": 0 }]
      ]
    },
    "Send Overdue Notification": {
      "main": [[{ "node": "Escalate Priority", "type": "main", "index": 0 }]]
    },
    "Send Critical Escalation": {
      "main": [[{ "node": "Escalate Priority", "type": "main", "index": 0 }]]
    },
    "Escalate Priority": {
      "main": [[{ "node": "Loop Over Overdue Tasks", "type": "main", "index": 0 }]]
    },
    "Log Scan Results": {
      "main": []
    },
    "Catch Errors": {
      "main": [[{ "node": "Log Error", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "errorWorkflow": "intentflow-automation-02" },
  "versionId": "a2000000-0002-0002-0002-000000000100",
  "meta": { "templateCredsSetupCompleted": false },
  "id": "intentflow-automation-02",
  "tags": [{ "createdAt": "2026-02-01T00:00:00.000Z", "updatedAt": "2026-02-01T00:00:00.000Z", "id": "tag-core", "name": "core" }]
