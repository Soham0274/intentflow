{
  "name": "04 - Email-to-Task Pipeline (Enhanced)",
  "nodes": [
    {
      "id": "a4000000-0004-0004-0004-000000000001",
      "name": "Email Trigger (IMAP)",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "mailbox": "INBOX",
        "action": "read",
        "downloadAttachments": false,
        "options": {
          "allowUnauthorizedCerts": false,
          "forceReconnect": true
        },
        "filters": {
          "unseenOnly": true
        }
      },
      "credentials": { "imap": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Capture Email" } }
    },
    {
      "id": "a4000000-0004-0004-0004-000000000001b",
      "name": "Check Email Size",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "sizeCheck",
              "leftValue": "={{ ($json.headers?.['content-length'] || 0) / 1024 }}",
              "rightValue": 1024,
              "operator": { "type": "number", "operation": "lt" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a4000000-0004-0004-0004-000000000002",
      "name": "Clean Email Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 220],
      "parameters": {
        "jsCode": "const emailData = $input.item.json;\n\nlet body = emailData.text || emailData.html || '';\nbody = body.replace(/<[^>]*>/g, ' ');\n\nconst signatures = [\n  '---', '--', '________________________',\n  'Best regards', 'Regards,', 'Thanks,', 'Thank you,',\n  'Sent from', 'Sent via', 'Sent using',\n  'On .* wrote:', 'From:', 'To:',\n  'This email', 'Confidential', 'Disclaimer'\n];\n\nsignatures.forEach(sig => {\n  const regex = new RegExp(sig, 'i');\n  body = body.split(regex)[0];\n});\n\nbody = body.replace(/\\s+/g, ' ').trim();\n\nconst senderRaw = emailData.from?.value?.[0]?.address\n  || (typeof emailData.from === 'string' ? emailData.from : '');\nconst senderEmail = senderRaw.match(/[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}/)?.[0] || senderRaw;\n\nconst subject = (emailData.subject || '').trim();\n\nif (body.length > 2000) body = body.substring(0, 2000) + '... [truncated]';\n\nreturn [{\n  json: {\n    cleanedBody: body,\n    senderEmail,\n    subject,\n    messageId: emailData.messageId,\n    receivedDate: emailData.date\n  }\n}];"
      }
    },
    {
      "id": "a4000000-0004-0004-0004-000000000003",
      "name": "Find User by Email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [900, 220],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, email, timezone, notification_settings, name FROM users WHERE email = '{{ $json.senderEmail }}' LIMIT 1;"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } }
    },
    {
      "id": "a4000000-0004-0004-0004-000000000004",
      "name": "Known User?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 220],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a4000000-0004-0004-0004-000000000004b",
      "name": "Get Cleaned Email Data",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 140],
      "parameters": {}
    },
    {
      "id": "a4000000-0004-0004-0004-000000000005",
      "name": "Check Spam Filter",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 160],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "spam1",
              "leftValue": "={{ !$('Get Cleaned Email Data').item.json.subject.toLowerCase().includes('unsubscribe') }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            },
            {
              "id": "spam2",
              "leftValue": "={{ !$('Get Cleaned Email Data').item.json.senderEmail.includes('noreply') && !$('Get Cleaned Email Data').item.json.senderEmail.includes('no-reply') }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a4000000-0004-0004-0004-000000000005b",
      "name": "Spam Rejected",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1560, 280],
      "parameters": {}
    },
    {
      "id": "a4000000-0004-0004-0004-000000000006",
      "name": "Call NLP API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 120],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/nlp/extract",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "input": "={{ $('Clean Email Body').item.json.subject }}. {{ $('Clean Email Body').item.json.cleanedBody }}",
          "source": "email"
        },
        "options": { "timeout": 30000 }
      },
      "onError": "continue"
    },
    {
      "id": "a4000000-0004-0004-0004-000000000007",
      "name": "NLP Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1780, 120],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "nlpCheck",
              "leftValue": "={{ $json.data && !$json.error }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a4000000-0004-0004-0004-000000000008",
      "name": "High Confidence?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2000, 80],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "confHigh",
              "leftValue": "={{ $json.confidence }}",
              "rightValue": 70,
              "operator": { "type": "number", "operation": "gte" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a4000000-0004-0004-0004-000000000009",
      "name": "Insert Task (Active)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2220, 40],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tasks (user_id, title, description, due_date, due_time, priority, category, status, confidence_score, metadata, source)\nVALUES (\n  '{{ $('Find User by Email').item.json.id }}',\n  '{{ $json.data.title }}',\n  '{{ $('Clean Email Body').item.json.cleanedBody }}',\n  {{ $json.data.due_date ? \"'\" + $json.data.due_date + \"'\" : 'NULL' }},\n  {{ $json.data.due_time ? \"'\" + $json.data.due_time + \"'\" : 'NULL' }},\n  '{{ $json.data.priority || 'medium' }}',\n  '{{ $json.data.category || 'work' }}',\n  'active',\n  {{ $json.confidence }},\n  '{\"source\": \"email\", \"subject\": \"{{ $('Clean Email Body').item.json.subject }}\", \"messageId\": \"{{ $('Clean Email Body').item.json.messageId }}\"}'::jsonb,\n  'email'\n)\nRETURNING *;"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } }
    },
    {
      "id": "a4000000-0004-0004-0004-000000000010",
      "name": "Insert Task (Pending Review)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2220, 120],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tasks (user_id, title, description, due_date, due_time, priority, category, status, confidence_score, metadata, source)\nVALUES (\n  '{{ $('Find User by Email').item.json.id }}',\n  '{{ $('Call NLP API').item.json.data.title || $('Clean Email Body').item.json.subject }}',\n  '{{ $('Clean Email Body').item.json.cleanedBody }}',\n  {{ $('Call NLP API').item.json.data.due_date ? \"'\" + $('Call NLP API').item.json.data.due_date + \"'\" : 'NULL' }},\n  {{ $('Call NLP API').item.json.data.due_time ? \"'\" + $('Call NLP API').item.json.data.due_time + \"'\" : 'NULL' }},\n  '{{ $('Call NLP API').item.json.data.priority || 'medium' }}',\n  '{{ $('Call NLP API').item.json.data.category || 'work' }}',\n  'pending',\n  {{ $('Call NLP API').item.json.confidence || 0 }},\n  '{\"source\": \"email\", \"subject\": \"{{ $('Clean Email Body').item.json.subject }}\", \"messageId\": \"{{ $('Clean Email Body').item.json.messageId }}\"}'::jsonb,\n  'email'\n)\nRETURNING *;"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } }
    },
    {
      "id": "a4000000-0004-0004-0004-000000000011",
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [2440, 80],
      "parameters": {
        "fromEmail": "tasks@intentflow.ai",
        "toEmail": "={{ $('Clean Email Body').item.json.senderEmail }}",
        "subject": "=✅ Task Created: {{ $json.title }}",
        "emailFormat": "html",
        "message": "=<html><body style=\"font-family: Arial, sans-serif; color: #333;\">\n<h2>✅ Your email was converted to a task</h2>\n<table style=\"border-collapse:collapse; width:100%; max-width:500px;\">\n  <tr style=\"background:#f3f4f6;\"><td style=\"padding:10px\"><strong>📋 Task</strong></td><td style=\"padding:10px\">{{ $json.title }}</td></tr>\n  <tr><td style=\"padding:10px\"><strong>📅 Due</strong></td><td style=\"padding:10px\">{{ $json.due_date || 'Not set' }} {{ $json.due_time || '' }}</td></tr>\n  <tr style=\"background:#f3f4f6;\"><td style=\"padding:10px\"><strong>⚡ Priority</strong></td><td style=\"padding:10px\">{{ $json.priority }}</td></tr>\n  <tr><td style=\"padding:10px\"><strong>🎯 Confidence</strong></td><td style=\"padding:10px\">{{ $json.confidence_score }}%</td></tr>\n</table>\n<p style=\"color:#f59e0b\">{{ $json.status === 'pending' ? '⚠️ Low confidence — please review this task in the app before it becomes active.' : '' }}</p>\n<p><a href=\"intentflow://task/{{ $json.id }}\">Open in IntentFlow AI</a></p>\n<hr/><p style=\"font-size:12px; color:#666;\">Reply STOP to disable email-to-task conversion.</p>\n</body></html>"
      },
      "credentials": { "smtp": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow SMTP" } },
      "onError": "continue"
    },
    {
      "id": "a4000000-0004-0004-0004-000000000012",
      "name": "Log Processed Email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2660, 80],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO email_processing_log (message_id, sender, subject, user_id, task_id, status, created_at) VALUES ('{{ $('Clean Email Body').item.json.messageId }}', '{{ $('Clean Email Body').item.json.senderEmail }}', '{{ $('Clean Email Body').item.json.subject }}', '{{ $('Find User by Email').item.json.id }}', '{{ $json.id }}', 'processed', NOW());"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } },
      "onError": "continue"
    },
