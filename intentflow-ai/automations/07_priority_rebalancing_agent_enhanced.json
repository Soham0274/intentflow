        "responseBody": "={\"success\": false, \"error\": \"At least 3 active tasks required for rebalancing\", \"code\": \"INSUFFICIENT_TASKS\"}",
        "options": { "responseCode": 400 }
      }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000019",
      "name": "Missing User ID",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 500],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": false, \"error\": \"Missing user_id parameter\", \"code\": \"MISSING_PARAM\"}",
        "options": { "responseCode": 400 }
      }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000020",
      "name": "Catch Errors",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [900, 620],
      "parameters": {}
    },
    {
      "id": "a7000000-0007-0007-0007-000000000021",
      "name": "Log Error",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1120, 620],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_errors (workflow_id, node_name, error_message, error_data, created_at) VALUES ('intentflow-automation-07', '{{ $json.errorNode }}', '{{ $json.errorMessage }}', '{{ JSON.stringify($json) }}', NOW());"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } }
    }
  ],
