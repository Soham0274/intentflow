{
  "name": "07 - Priority Rebalancing Agent (Enhanced)",
  "nodes": [
    {
      "id": "a7000000-0007-0007-0007-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "rebalance-priorities",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000002",
      "name": "Daily 6PM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 460],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 18 * * *" }]
        }
      }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000003",
      "name": "Merge Triggers",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [460, 380],
      "parameters": { "mode": "chooseBranch", "chooseBranchMode": "waitForAll", "output": "both" }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000004",
      "name": "Validate User Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 380],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "userCheck",
              "leftValue": "={{ $json.body?.user_id || $json.user_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000005",
      "name": "Get User Active Tasks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [900, 340],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  id,\n  title,\n  description,\n  due_date,\n  priority,\n  created_at,\n  category,\n  status,\n  estimated_minutes,\n  COALESCE(estimated_minutes, 30) as task_weight,\n  CASE WHEN due_date IS NOT NULL THEN due_date - CURRENT_DATE ELSE NULL END AS days_until_due\nFROM tasks\nWHERE user_id = '{{ $json.body?.user_id || $json.user_id }}'\n  AND status = 'active'\nORDER BY due_date ASC NULLS LAST\nLIMIT 50;"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000006",
      "name": "Has Tasks?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 340],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "tasksExist",
              "leftValue": "={{ $json.length }}",
              "rightValue": 3,
              "operator": { "type": "number", "operation": "gte" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000007",
      "name": "AI Priority Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 280],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.OPENAI_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"model\": \"gpt-4\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a productivity AI. Analyze the task list and suggest priority adjustments. Return ONLY valid JSON: {\\\"adjustments\\\": [{\\\"task_id\\\": \\\"uuid\\\", \\\"new_priority\\\": \\\"high|medium|low\\\", \\\"reason\\\": \\\"brief reason\\\", \\\"confidence\\\": 0-100}]}. Only include tasks that need a priority change. Prioritize tasks due soon, high-impact work, and tasks blocking others.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Current tasks: {{ JSON.stringify($json) }}\"\n    }\n  ],\n  \"response_format\": { \"type\": \"json_object\" },\n  \"temperature\": 0.2\n}",
        "options": { "timeout": 30000 }
      },
      "onError": "continue"
    },
    {
      "id": "a7000000-0007-0007-0007-000000000008",
      "name": "AI Call Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 280],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "success",
              "leftValue": "={{ $json.choices && $json.choices.length > 0 }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000009",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 240],
      "parameters": {
        "jsCode": "const content = $input.item.json.choices[0].message.content;\nlet parsed;\ntry {\n  parsed = typeof content === 'string' ? JSON.parse(content) : content;\n} catch (e) {\n  return [{ json: { adjustments: [], error: 'Parse failed' } }];\n}\n\n// Validate and filter adjustments\nconst valid = (parsed.adjustments || []).filter(a => {\n  return a.task_id && a.new_priority && ['high', 'medium', 'low'].includes(a.new_priority);\n});\n\nreturn [{ json: { adjustments: valid } }];"
      }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000010",
      "name": "Has Adjustments?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2000, 240],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "hasAdjust",
              "leftValue": "={{ $json.adjustments.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000011",
      "name": "Apply Priority Updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 200],
      "parameters": {
        "jsCode": "const adjustments = $input.item.json.adjustments;\nconst userId = $('Validate User Input').item.json.body?.user_id || $('Validate User Input').item.json.user_id;\n\nconst statements = adjustments.map(a =>\n  `UPDATE tasks SET priority = '${a.new_priority}', ai_rebalanced_at = NOW(), ai_rebalance_reason = '${a.reason.replace(/'/g, \"''\")}' WHERE id = '${a.task_id}' AND user_id = '${userId}';`\n).join('\\n');\n\nreturn [{ json: { sql: statements, count: adjustments.length, adjustments, user_id: userId } }];"
      }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000012",
      "name": "Execute Priority Updates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2440, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sql }}"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } },
      "onError": "continue"
    },
    {
      "id": "a7000000-0007-0007-0007-000000000013",
      "name": "Notify User of Changes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2660, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/notifications/send",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "user_id": "={{ $('Apply Priority Updates').item.json.user_id }}",
          "message": "=🤖 AI rebalanced {{ $('Apply Priority Updates').item.json.count }} task priorities based on deadlines and impact. Review the changes?",
          "type": "priority_rebalanced",
          "data": "={{ JSON.stringify($('Apply Priority Updates').item.json.adjustments) }}",
          "action_url": "intentflow://tasks/priority-review"
        },
        "options": { "timeout": 10000 }
      },
      "onError": "continue"
    },
    {
      "id": "a7000000-0007-0007-0007-000000000014",
      "name": "Log Rebalance Activity",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2880, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ai_rebalance_logs (user_id, tasks_analyzed, changes_made, adjustments_json, created_at) VALUES ('{{ $('Apply Priority Updates').item.json.user_id }}', {{ $('Get User Active Tasks').item.json.length }}, {{ $('Apply Priority Updates').item.json.count }}, '{{ JSON.stringify($('Apply Priority Updates').item.json.adjustments) }}'::jsonb, NOW());"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } },
      "onError": "continue"
    },
    {
      "id": "a7000000-0007-0007-0007-000000000015",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [3100, 200],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"adjustments_made\": {{ $('Apply Priority Updates').item.json.count || 0 }}, \"message\": \"Priority rebalancing completed\"}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "a7000000-0007-0007-0007-000000000016",
