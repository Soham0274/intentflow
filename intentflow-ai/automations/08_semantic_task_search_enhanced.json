{
  "name": "08 - Semantic Task Search (Generate Embedding) (Enhanced)",
  "nodes": [
    {
      "id": "a8000000-0008-0008-0008-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-embedding",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "a8000000-0008-0008-0008-000000000002",
      "name": "Validate Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a8000000-0008-0008-0008-000000000002b",
      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "req1",
              "leftValue": "={{ $json.body.data.task_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            },
            {
              "id": "req2",
              "leftValue": "={{ $json.body.data.title }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a8000000-0008-0008-0008-000000000003",
      "name": "Build Embedding Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 260],
      "parameters": {
        "jsCode": "const task = $input.item.json.body.data;\n\n// Combine meaningful fields for richer embedding\nconst text = [\n  task.title,\n  task.description || '',\n  task.category || '',\n  task.priority || '',\n  task.tags?.join(' ') || ''\n].filter(Boolean).join('. ').trim();\n\nif (!text) {\n  return [{ json: { error: 'No valid text to embed', task_id: task.task_id } }];\n}\n\n// Limit text length for API\nconst limitedText = text.length > 8000 ? text.substring(0, 8000) : text;\n\nreturn [{ json: { task_id: task.task_id, embedding_text: limitedText, original_length: text.length } }];"
      }
    },
    {
      "id": "a8000000-0008-0008-0008-000000000004",
      "name": "Check Text Length",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 260],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "hasText",
              "leftValue": "={{ !$json.error && $json.embedding_text.length > 0 }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a8000000-0008-0008-0008-000000000005",
      "name": "Call OpenAI Embeddings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.OPENAI_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"model\": \"text-embedding-3-small\",\n  \"input\": \"{{ $json.embedding_text }}\"\n}",
        "options": { "timeout": 30000 }
      },
      "onError": "continue"
    },
    {
      "id": "a8000000-0008-0008-0008-000000000006",
      "name": "Embedding Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 200],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "success",
              "leftValue": "={{ $json.data && $json.data[0] && $json.data[0].embedding }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a8000000-0008-0008-0008-000000000007",
      "name": "Store or Update Embedding",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1780, 160],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO task_embeddings (task_id, embedding, model_used, created_at)\nVALUES (\n  '{{ $('Build Embedding Text').item.json.task_id }}',\n  '{{ JSON.stringify($json.data[0].embedding) }}'::vector,\n  'text-embedding-3-small',\n  NOW()\n)\nON CONFLICT (task_id)\nDO UPDATE SET\n  embedding   = EXCLUDED.embedding,\n  model_used  = EXCLUDED.model_used,\n  updated_at  = NOW();"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } },
      "onError": "continue"
    },
    {
      "id": "a8000000-0008-0008-0008-000000000008",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2000, 160],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"task_id\": \"{{ $('Build Embedding Text').item.json.task_id }}\", \"embedding_stored\": true, \"text_length\": {{ $('Build Embedding Text').item.json.original_length }}}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "a8000000-0008-0008-0008-000000000009",
      "name": "Embedding Failed Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1780, 260],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": false, \"error\": \"Failed to generate embedding\", \"code\": \"EMBEDDING_ERROR\"}",
        "options": { "responseCode": 503 }
      }
    },
    {
      "id": "a8000000-0008-0008-0008-000000000010",
      "name": "No Text to Embed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 360],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": false, \"error\": \"No valid text to generate embedding\", \"code\": \"NO_CONTENT\"}",
        "options": { "responseCode": 400 }
      }
    },
    {
      "id": "a8000000-0008-0008-0008-000000000011",
      "name": "Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 460],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\": \"Unauthorized\", \"code\": \"AUTH_FAILED\"}",
        "options": { "responseCode": 401 }
      }
    },
    {
      "id": "a8000000-0008-0008-0008-000000000012",
      "name": "Missing Fields",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 420],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\": \"Missing required fields: task_id, title\", \"code\": \"VALIDATION_ERROR\"}",
        "options": { "responseCode": 400 }
      }
    },
    {
      "id": "a8000000-0008-0008-0008-000000000013",
      "name": "Catch Errors",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [900, 560],
      "parameters": {}
    },
    {
      "id": "a8000000-0008-0008-0008-000000000014",
      "name": "Log Error",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1120, 560],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_errors (workflow_id, node_name, error_message, error_data, created_at) VALUES ('intentflow-automation-08', '{{ $json.errorNode }}', '{{ $json.errorMessage }}', '{{ JSON.stringify($json) }}', NOW());"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Validate Secret", "type": "main", "index": 0 }]]
    },
