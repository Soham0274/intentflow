{
  "name": "EX1 - Task Updated Handler (Enhanced)",
  "nodes": [
    {
      "id": "ex100000-ex01-ex01-ex01-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "task-updated",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000002",
      "name": "Validate Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000003",
      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "req1",
              "leftValue": "={{ $json.body.data.task_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            },
            {
              "id": "req2",
              "leftValue": "={{ $json.body.changed_fields }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000004",
      "name": "What Changed?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [900, 220],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {},
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.body.changed_fields?.includes('title') || $json.body.changed_fields?.includes('description') || $json.body.changed_fields?.includes('category') }}",
                    "rightValue": true,
                    "operator": { "type": "boolean", "operation": "true" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "text_changed"
            },
            {
              "conditions": {
                "options": {},
                "conditions": [
                  {
                    "id": "c2",
                    "leftValue": "={{ $json.body.changed_fields?.includes('due_date') || $json.body.changed_fields?.includes('due_time') }}",
                    "rightValue": true,
                    "operator": { "type": "boolean", "operation": "true" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "date_changed"
            },
            {
              "conditions": {
                "options": {},
                "conditions": [
                  {
                    "id": "c3",
                    "leftValue": "={{ $json.body.changed_fields?.includes('priority') }}",
                    "rightValue": true,
                    "operator": { "type": "boolean", "operation": "true" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "priority_changed"
            }
          ]
        },
        "fallbackOutput": "none"
      }
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000005",
      "name": "Regenerate Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 120],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE_URL }}/webhook/generate-embedding",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "data": "={{ $('Validate Required Fields').item.json.body.data }}"
        },
        "options": { "timeout": 15000 }
      },
      "onError": "continue"
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000006",
      "name": "Embedding Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 120],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "embedOk",
              "leftValue": "={{ $json.success === true }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000007",
      "name": "Update Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [1120, 260],
      "parameters": {
        "operation": "update",
        "calendar": { "__rl": true, "value": "primary", "mode": "id" },
        "eventId": "={{ $('Validate Required Fields').item.json.body.data.calendar_event_id }}",
        "updateFields": {
          "start": "={{ $('Validate Required Fields').item.json.body.data.due_date }}T{{ $('Validate Required Fields').item.json.body.data.due_time || '09:00' }}:00",
          "end": "={{ $('Validate Required Fields').item.json.body.data.due_date }}T{{ ($('Validate Required Fields').item.json.body.data.due_time || '09:00').split(':').map((v,i) => i===0 ? String(parseInt(v)+1).padStart(2,'0') : v).join(':') }}:00",
          "summary": "={{ $('Validate Required Fields').item.json.body.data.title }}"
        }
      },
      "credentials": { "googleCalendarOAuth2Api": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Google Calendar" } },
      "onError": "continue"
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000008",
      "name": "Has Calendar Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 260],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "hasCal",
              "leftValue": "={{ $('Validate Required Fields').item.json.body.data.calendar_event_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000009",
      "name": "Log Priority Change",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1120, 400],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO task_history (task_id, field_name, old_value, new_value, changed_at, change_source) VALUES ('{{ $('Validate Required Fields').item.json.body.data.task_id }}', 'priority', 'previous', '{{ $('Validate Required Fields').item.json.body.data.priority }}', NOW(), 'user_update');"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } },
      "onError": "continue"
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000010",
      "name": "Log Update Activity",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1780, 220],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO task_update_log (task_id, changed_fields, updated_at, user_id) VALUES ('{{ $('Validate Required Fields').item.json.body.data.task_id }}', '{{ JSON.stringify($('Validate Required Fields').item.json.body.changed_fields) }}', NOW(), '{{ $('Validate Required Fields').item.json.body.data.user_id }}');"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } },
      "onError": "continue"
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000011",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2000, 220],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"task_id\": \"{{ $('Validate Required Fields').item.json.body.data.task_id }}\", \"updated\": true, \"actions\": {\"embedding_regenerated\": true, \"calendar_updated\": true}}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000012",
      "name": "Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 480],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\": \"Unauthorized\", \"code\": \"AUTH_FAILED\"}",
        "options": { "responseCode": 401 }
      }
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000013",
      "name": "Missing Fields",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 480],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\": \"Missing required fields: task_id, changed_fields\", \"code\": \"VALIDATION_ERROR\"}",
        "options": { "responseCode": 400 }
      }
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000014",
      "name": "No Changes Detected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 560],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"message\": \"No relevant changes detected\", \"actions\": {}}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000015",
      "name": "Catch Errors",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [460, 640],
      "parameters": {}
    },
    {
      "id": "ex100000-ex01-ex01-ex01-000000000016",
      "name": "Log Error",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [680, 640],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_errors (workflow_id, node_name, error_message, error_data, created_at) VALUES ('intentflow-automation-ex1', '{{ $json.errorNode }}', '{{ $json.errorMessage }}', '{{ JSON.stringify($json) }}', NOW());"
      },
      "credentials": { "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "IntentFlow Database" } }
    }
  ],
  "connections": {
